# Local development only. Copy to .env; never commit .env.
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=transaction_analytics
POSTGRES_PORT=5433

# The app and Alembic read DATABASE_URL. User/password/port must match the values above;
# percent-encode special characters in the password.
DATABASE_URL=postgresql+asyncpg://analytics:change-me-local-only@127.0.0.1:5433/transaction_analytics

# Integration tests DROP and recreate this database on every run. Its name must end in "_test";
# the tests refuse to run otherwise. Never point it at a database you care about.
TEST_DATABASE_URL=postgresql+asyncpg://analytics:change-me-local-only@127.0.0.1:5433/transaction_analytics_test
